<Window x:Class="OmniDeploy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OmniDeploy.Ui"
        Title="OmniDeploy - Mídia de Implantação"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        MinWidth="1000" MinHeight="660" Width="1280" Height="840"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolVis" />
        <ui:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
        <ui:InverseBoolConverter x:Key="Not" />
        <ui:StepVisibilityConverter x:Key="StepVis" />
        <ui:NullToVisibilityConverter x:Key="NullVis" />
        <ui:NullToVisibilityConverter x:Key="NullVisInv" Invert="True" />
        <ui:LogLevelBrushConverter x:Key="LogBrush" />
        <ui:LogLevelWeightConverter x:Key="LogWeight" />
        <ui:HexBrushConverter x:Key="HexBrush" />

        <!-- Botão de etapa da barra lateral -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="circ" Fill="{StaticResource Surface3}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                    <TextBlock x:Name="num" Text="{Binding Numero}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <Path x:Name="tick" Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.4"
                                          Stretch="Uniform" Width="12" Height="12" Visibility="Collapsed"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="tit" Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Subtitulo}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#141E33" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Concluido}" Value="True">
                                <Setter TargetName="circ" Property="Fill" Value="{StaticResource Success}" />
                                <Setter TargetName="circ" Property="Stroke" Value="{StaticResource Success}" />
                                <Setter TargetName="num" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="tit" Property="Foreground" Value="{StaticResource Text}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16264A" />
                                <Setter TargetName="circ" Property="Fill" Value="{StaticResource AccentGradient}" />
                                <Setter TargetName="circ" Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter TargetName="num" Property="Foreground" Value="White" />
                                <Setter TargetName="tit" Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource Surface3}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== CABEÇALHO ============================== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="22,14" x:Name="Header">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="50" Height="50" CornerRadius="13" Background="{StaticResource AccentGradient}" Margin="0,0,16,0">
                    <Grid>
                        <Path Data="M 8,14 H 42 V 30 H 8 Z M 18,36 H 32 M 25,30 V 36" Stroke="White" StrokeThickness="2.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.95" />
                        <TextBlock Text="OmniDeploy" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Top" Margin="0,17,0,0" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="8" Padding="8,1" Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersaoBadge}" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#A78BFA" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AmbienteTexto}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="Modo de boot detectado em tempo real">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12">
                                <Run Text="Boot: " Foreground="{StaticResource Muted}" /><Run Text="{Binding ModoBootTexto, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" ToolTip="Partição de dados do pendrive">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotDados" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DadosEncontrados}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding UnidadeDadosTexto}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="14,0,0,0" ToolTip="Fechar aplicativo"
                        Command="{Binding FecharCommand}" VerticalAlignment="Center" Padding="10,8">
                    <Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="{StaticResource Muted}" StrokeThickness="1.8" />
                </Button>
            </Grid>
        </Border>

        <!-- ============================== CORPO ============================== -->
        <Grid Grid.Row="1" Margin="18,16,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Diagnóstico de hardware -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Diagnóstico de Hardware" Style="{StaticResource H2}" />
                                <TextBlock Text="consultando WMI…" HorizontalAlignment="Right" Style="{StaticResource Caption}"
                                           Visibility="{Binding CarregandoHardware, Converter={StaticResource BoolVis}}" />
                            </Grid>

                            <TextBlock Text="FABRICANTE / MODELO" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Hardware.FabricanteModelo}" Style="{StaticResource Value}" FontWeight="SemiBold" />

                            <TextBlock Text="PROCESSADOR" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Hardware.Processador}" Style="{StaticResource Value}" />

                            <TextBlock Text="NÚMERO DE SÉRIE / SERVICE TAG" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="10,6" Margin="0,4,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Hardware.NumeroSerie, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             Background="Transparent" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="15"
                                             FontWeight="Bold" Foreground="#FDE68A" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Command="{Binding CopiarSerialCommand}"
                                            ToolTip="Copiar número de série">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource Text}" StrokeThickness="1.6"
                                                  Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Copiar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Hardware.MemoriaRam}" Style="{StaticResource Value}" />

                            <Border Background="{StaticResource SuccessSoft}" CornerRadius="8" Padding="10,7" Margin="0,14,0,0">
                                <TextBlock FontSize="11" Foreground="#6EE7B7" TextWrapping="Wrap"
                                           Text="Sem bloqueios de TPM 2.0, Secure Boot ou RAM mínima: a imagem é aplicada diretamente via DISM." />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Etapas -->
                    <Border Style="{StaticResource Card}" Padding="10,12" Margin="0,14,0,16">
                        <StackPanel>
                            <TextBlock Text="ETAPAS" Style="{StaticResource Label}" Margin="10,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Etapas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource StepButton}"
                                                Command="{Binding DataContext.IrParaEtapaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Indice}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Conteúdo da etapa -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding TituloEtapa}" Style="{StaticResource Label}" Foreground="#93C5FD" Margin="0,0,0,6" />

                    <!-- ===================== ETAPA 1 – DISCO ===================== -->
                    <Grid Grid.Row="1" Visibility="{Binding EtapaAtual, Converter={StaticResource StepVis}, ConverterParameter=0}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Selecione o disco de destino" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,12"
                                           Text="O disco escolhido será totalmente apagado. O pendrive de boot é ocultado automaticamente." />
                            </StackPanel>
                            <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding AtualizarDiscosCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource Text}" StrokeThickness="1.8" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" />
                                    <TextBlock Text="Atualizar" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Discos}" SelectedItem="{Binding DiscoSelecionado}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource Surface3}" Margin="0,0,14,0">
                                                <Path Data="M 4,8 H 28 V 22 H 4 Z M 8,17 H 9 M 12,17 H 24" Stroke="#93C5FD" StrokeThickness="1.8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" StrokeLineJoin="Round" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detalhes}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TamanhoTexto}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#93C5FD" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Discos.Count, Converter={StaticResource NullVisInv}}">
                                <TextBlock Text="Nenhum disco interno disponível" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                                           Text="Se o disco NVMe/RAID não aparecer, adicione o driver de armazenamento (Intel RST/VMD) em 02_Drivers&#x0a;e injete-o no WinPE, ou altere o modo SATA na BIOS para AHCI." />
                            </StackPanel>
                            <TextBlock Text="Carregando discos…" Style="{StaticResource Caption}" VerticalAlignment="Top" HorizontalAlignment="Right"
                                       Visibility="{Binding CarregandoDiscos, Converter={StaticResource BoolVis}}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding DiscosOcultosTexto}" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,0,0,10"
                                       Visibility="{Binding DiscosOcultosTexto, Converter={StaticResource NullVis}}" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MAPA DE PARTIÇÕES QUE SERÁ CRIADO" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding LayoutTexto}" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,10" />
                                    <ItemsControl ItemsSource="{Binding MapaParticoes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ui:ProportionalPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Cor, Converter={StaticResource HexBrush}}" CornerRadius="7" Margin="0,0,4,0" Padding="10,8" Height="58">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detalhe}" Foreground="#EAF2FF" FontSize="11" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Foreground="{StaticResource Warning}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding AvisoMbr2Tb, Converter={StaticResource BoolVis}}"
                                               Text="Atenção: em modo Legacy (MBR) apenas os primeiros 2 TB do disco poderão ser utilizados." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ===================== ETAPA 2 – IMAGEM ===================== -->
                    <Grid Grid.Row="1" Visibility="{Binding EtapaAtual, Converter={StaticResource StepVis}, ConverterParameter=1}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Imagem e edição do Windows" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,12">
                                    <Run Text="Arquivos .wim/.esd encontrados em " /><Run Text="{Binding PastaImagensTexto, Mode=OneWay}" Foreground="#93C5FD" />
                                </TextBlock>
                            </StackPanel>
                            <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding AtualizarImagensCommand}" Content="Atualizar" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="ARQUIVO DE IMAGEM" Style="{StaticResource Label}" Margin="0,0,0,8" />
                                <Grid>
                                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Imagens}" SelectedItem="{Binding ImagemSelecionada}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="7,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tipo}" FontWeight="Bold" FontSize="11" Foreground="#93C5FD" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TamanhoTexto}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Nenhum arquivo .wim/.esd em 01_ISOs_Imagens." Style="{StaticResource Caption}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Imagens.Count, Converter={StaticResource NullVisInv}}" />
                                </Grid>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="EDIÇÃO (ÍNDICE)" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding StatusEdicoes}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Edicoes}" SelectedItem="{Binding EdicaoSelecionada}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Surface3}" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Indice}" FontWeight="Bold" FontSize="14" Foreground="#93C5FD"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Descricao}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Tamanho}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Lendo edições via DISM…" Style="{StaticResource H2}" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding CarregandoEdicoes, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </Grid>

                    <!-- ===================== ETAPA 3 – MODO ===================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding EtapaAtual, Converter={StaticResource StepVis}, ConverterParameter=2}">
                        <StackPanel>
                            <TextBlock Text="Modo de implantação" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,16"
                                       Text="Define como o Windows se comportará no primeiro boot (OOBE)." />

                            <RadioButton Style="{StaticResource OptionCard}" GroupName="modo" IsChecked="{Binding ModoIntune}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Corporativo / Intune" FontSize="16" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource AccentSoft}" Margin="10,0,0,0">
                                            <TextBlock Text="Entra ID • Autopilot" FontSize="11" Foreground="#93C5FD" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"
                                               Text="OOBE limpo, sem arquivo unattend de usuário. O equipamento inicia a experiência padrão da Microsoft, pronto para ingresso no Entra ID / registro no Windows Autopilot e gerenciamento pelo Intune." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource OptionCard}" GroupName="modo" IsChecked="{Binding ModoBypass}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bypass / Conta Local" FontSize="16" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource WarningSoft}" Margin="10,0,0,0">
                                            <TextBlock Text="unattend_bypass.xml" FontSize="11" Foreground="#FCD34D" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"
                                               Text="Injeta unattend_bypass.xml em C:\Windows\Panther\. Pula a exigência de internet e de conta Microsoft (BypassNRO), permitindo criar um usuário local offline durante o OOBE." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource OptionCard}" GroupName="modo" IsChecked="{Binding ModoZeroTouch}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Zero-Touch Bancada" FontSize="16" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource SuccessSoft}" Margin="10,0,0,0">
                                            <TextBlock Text="unattend_zerotouch.xml" FontSize="11" Foreground="#6EE7B7" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0">
                                        <Run Text="Injeta unattend_zerotouch.xml em C:\Windows\Panther\. Cria automaticamente o usuário local " /><Run Text="{Binding UsuarioZeroTouch, Mode=OneWay}" Foreground="#6EE7B7" FontWeight="SemiBold" /><Run Text=" (definido no config.json), pula todo o OOBE e vai direto para a Área de Trabalho." />
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== ETAPA 4 – DRIVERS ===================== -->
                    <Grid Grid.Row="1" Visibility="{Binding EtapaAtual, Converter={StaticResource StepVis}, ConverterParameter=3}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Drivers sob demanda" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,12">
                                    <Run Text="Cada subpasta de " /><Run Text="{Binding PastaDriversTexto, Mode=OneWay}" Foreground="#93C5FD" /><Run Text=" aparece aqui automaticamente. INF → DISM /Add-Driver; .bat/.cmd/.reg → registro offline + SetupComplete." />
                                </TextBlock>
                            </StackPanel>
                            <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding AtualizarDriversCommand}" Content="Atualizar" />
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding DriversRecomendadosTexto}" Foreground="#BFDBFE" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Drivers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8"
                                                    BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selecionado}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="14" />
                                                            <TextBlock Text="{Binding Resumo}" Style="{StaticResource Caption}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <Border Grid.Column="1" Style="{StaticResource Tag}" Background="{StaticResource SuccessSoft}" VerticalAlignment="Center"
                                                            Visibility="{Binding Recomendado, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="Recomendado para este hardware" FontSize="11" Foreground="#6EE7B7" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Nenhuma pasta encontrada em 02_Drivers." Style="{StaticResource Caption}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Drivers.Count, Converter={StaticResource NullVisInv}}" />
                        </Grid>
                    </Grid>

                    <!-- ===================== ETAPA 5 – PÓS-INSTALAÇÃO ===================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding EtapaAtual, Converter={StaticResource StepVis}, ConverterParameter=4}">
                        <StackPanel>
                            <TextBlock Text="Scripts pós-instalação" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,16"
                                       Text="Os itens marcados são gravados em C:\Windows\Setup\Scripts\SetupComplete.cmd e executados automaticamente ao final da instalação." />

                            <Border Background="{StaticResource Surface2}" CornerRadius="12" Padding="18,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding SincronizarNtp}">
                                    <StackPanel>
                                        <TextBlock Text="Sincronização de horário (NTP)" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="12">
                                            <Run Text="Fuso E. South America Standard Time (Brasília) • servidor " /><Run Text="{Binding ServidorNtp, Mode=OneWay}" Foreground="#93C5FD" /><Run Text=" • 01_Sincronizar_Horario_NTP.bat" />
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="{StaticResource Surface2}" CornerRadius="12" Padding="18,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding AtivarWindows}">
                                        <StackPanel>
                                            <TextBlock Text="Ativação do Windows" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="slmgr.vbs /ipk + /ato silenciosos • 02_Ativar_Windows.bat" Style="{StaticResource Caption}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>

                                    <StackPanel Margin="30,14,0,0" IsEnabled="{Binding AtivarWindows}">
                                        <RadioButton GroupName="chave" IsChecked="{Binding UsarChavePadrao}" Content="Usar chave existente (OmniDeploy)" FontWeight="SemiBold" />
                                        <Grid Margin="30,8,0,14" IsEnabled="{Binding UsarChavePadrao}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="420" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#0D1426" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding ChavePadraoExibida}" FontFamily="{StaticResource MonoFont}" FontSize="15" Foreground="#FDE68A" />
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding AlternarChaveCommand}"
                                                    ToolTip="Revelar / ocultar chave">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconEye}" Stroke="{StaticResource Text}" StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="10" Margin="0,0,6,0" />
                                                    <TextBlock Text="Revelar" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <RadioButton GroupName="chave" IsChecked="{Binding UsarChaveManual}" Content="Digitar chave manual" FontWeight="SemiBold" />
                                        <TextBox x:Name="TxtChave" Margin="30,8,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="15" MaxLength="29" CharacterCasing="Upper"
                                                 Text="{Binding ChaveManual, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsarChaveManual}" TextChanged="TxtChave_TextChanged" />
                                        <TextBlock Margin="30,6,0,0" FontSize="12" Text="{Binding StatusChave}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChaveValida}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="30,2,0,0" Style="{StaticResource Caption}" Text="Formato: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX (os hífens são inseridos automaticamente)." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== ETAPA 6 – EXECUÇÃO ===================== -->
                    <Grid Grid.Row="1" Visibility="{Binding EtapaAtual, Converter={StaticResource StepVis}, ConverterParameter=5}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Visibility="{Binding MostrarResumo, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Resumo da implantação" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,12"
                                       Text="Confira tudo antes de iniciar. Sequência: diskpart → dism /Apply-Image → bcdboot → dism /Add-Driver → unattend + SetupComplete.cmd" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding Resumo}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rotulo}" Foreground="{StaticResource Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Valor}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource Surface2}" CornerRadius="10" Padding="16,12" Margin="0,12,0,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Fase}" FontWeight="SemiBold" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TempoDecorrido}" Foreground="{StaticResource Muted}" Margin="0,0,14,0" FontFamily="{StaticResource MonoFont}" />
                                        <TextBlock Text="{Binding ProgressoTexto}" FontWeight="Bold" FontSize="14" Foreground="#93C5FD" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="{Binding Progresso, Mode=OneWay}" Maximum="100" />
                                <Border Background="{StaticResource SuccessSoft}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                        Visibility="{Binding Concluido, Converter={StaticResource BoolVis}}">
                                    <TextBlock Foreground="#6EE7B7" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="Windows implantado com sucesso! Clique em &quot;Reiniciar agora&quot; para iniciar o primeiro boot." />
                                </Border>
                                <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                        Visibility="{Binding Falhou, Converter={StaticResource BoolVis}}">
                                    <TextBlock Foreground="#FCA5A5" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="A implantação falhou. Verifique o console abaixo; o log completo foi salvo na pasta Logs do pendrive." />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="#060A14" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#0B1222" CornerRadius="10,10,0,0" Padding="12,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="#EF4444" Margin="0,0,6,0" />
                                        <Ellipse Width="9" Height="9" Fill="#F59E0B" Margin="0,0,6,0" />
                                        <Ellipse Width="9" Height="9" Fill="#10B981" Margin="0,0,12,0" />
                                        <TextBlock Text="Console ao vivo — OmniDeploy" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0"
                                         Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinHeight="120">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HoraTexto}" Foreground="#475569" />
                                                <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap"
                                                           Foreground="{Binding Nivel, Converter={StaticResource LogBrush}}"
                                                           FontWeight="{Binding Nivel, Converter={StaticResource LogWeight}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="1" Text="O log detalhado aparecerá aqui após iniciar a implantação." FontFamily="{StaticResource MonoFont}"
                                           Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Log.Count, Converter={StaticResource NullVisInv}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== RODAPÉ ============================== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BaseButton}" Command="{Binding AbrirCmdCommand}" Content="Prompt (CMD)" Padding="14,8"
                            ToolTip="Abre um prompt de comando para diagnóstico" />
                    <Button Style="{StaticResource BaseButton}" Command="{Binding DesligarCommand}" Content="Desligar" Padding="14,8" Margin="8,0,0,0" />
                    <Border Background="{StaticResource SuccessSoft}" CornerRadius="8" Padding="12,7" Margin="14,0,0,0"
                            Visibility="{Binding Toast, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Toast}" Foreground="#6EE7B7" FontSize="12" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BaseButton}" Content="← Voltar" Command="{Binding VoltarCommand}" Margin="0,0,10,0"
                            Visibility="{Binding MostrarResumo, Converter={StaticResource BoolVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Próximo →" Command="{Binding ProximoCommand}" MinWidth="140"
                            Visibility="{Binding EhUltimaEtapa, Converter={StaticResource BoolVisInv}}" />

                    <Grid Visibility="{Binding EhUltimaEtapa, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource DangerButton}" Content="Iniciar implantação" Command="{Binding SolicitarInicioCommand}" MinWidth="180"
                                    Visibility="{Binding MostrarResumo, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="Implantação em andamento — não desligue o computador…" Foreground="{StaticResource Warning}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Visibility="{Binding Executando, Converter={StaticResource BoolVis}}" />
                            <Button Style="{StaticResource BaseButton}" Content="Nova implantação" Command="{Binding NovaImplantacaoCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding Finalizado, Converter={StaticResource BoolVis}}" />
                            <Button Style="{StaticResource SuccessButton}" Content="Reiniciar agora" Command="{Binding ReiniciarCommand}" MinWidth="160"
                                    Visibility="{Binding Concluido, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== CONFIRMAÇÃO ============================== -->
        <Grid Grid.RowSpan="3" Background="#CC03060D" Visibility="{Binding ConfirmacaoVisivel, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24"
                    BorderBrush="{StaticResource Danger}" BorderThickness="1.5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource DangerSoft}" Margin="0,0,14,0">
                            <Path Data="M 12,3 L 22,20 H 2 Z M 12,9 V 14 M 12,17 V 17.5" Stroke="#F87171" StrokeThickness="2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Confirmar formatação" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding DiscoConfirmacaoTexto}" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0" Foreground="#FCA5A5" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"
                               Text="Esta operação não pode ser desfeita. O Windows será aplicado e configurado conforme as opções escolhidas." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Cancelar" Command="{Binding CancelarConfirmacaoCommand}" Margin="0,0,10,0" IsCancel="True" />
                        <Button Style="{StaticResource DangerButton}" Content="Sim, apagar e instalar" Command="{Binding IniciarCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


{
  "name": "apresentacao-deploy-windows",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeo Motion Graphics em Remotion apresentando o sistema de automação de deploy e mídia de instalação do Windows",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render MainVideo out/apresentacao-linkedin.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:vertical": "remotion render VerticalLinkedIn out/apresentacao-linkedin-vertical-60fps.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@remotion/cli": "^4.0.290",
    "@remotion/transitions": "^4.0.290",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.290"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.3"
  }
}
